#!/usr/bin/env bash
# Redeem this proxy's one-time bootstrap token for its TLS material
# (SPEC.md section 8).
#
# Called once by cloud-init at first boot. The material is NOT in the
# userdata: that document is readable through the CloudStack API, so a
# private key there is a private key published. The token is, and it is
# single-use, short-lived and bound to one certificate — so a userdata
# document read later yields something already spent.
#
# The token is therefore burned the first time this runs, successfully
# or not, from the engine's point of view. A retry needs a redeployed
# proxy, which is why this writes nothing until it has everything.
set -euo pipefail

usage() {
    echo "usage: aisvc-fetch-cert --token <token> [--out <dir>] [--engine <url>]" >&2
    exit 2
}

TOKEN=""
OUT_DIR="/etc/aisvc/tls"
ENGINE="${AISVC_ENGINE_URL:-}"

while [ $# -gt 0 ]; do
    case "$1" in
        --token) TOKEN="${2:-}"; shift 2 ;;
        --out) OUT_DIR="${2:-}"; shift 2 ;;
        --engine) ENGINE="${2:-}"; shift 2 ;;
        *) usage ;;
    esac
done

[ -n "$TOKEN" ] || usage
if [ -z "$ENGINE" ]; then
    echo "aisvc-fetch-cert: no engine URL; set AISVC_ENGINE_URL or pass --engine" >&2
    exit 1
fi

install -d -m 0700 "$OUT_DIR"
umask 077

response="$(mktemp)"
request="$(mktemp)"
# Removed whatever happens: the response holds a private key and the
# request holds the token.
trap 'rm -f "$response" "$request"' EXIT

# The token goes in the body rather than the URL: paths reach access
# logs and proxies, bodies do not.
printf '{"token":"%s"}' "$TOKEN" > "$request"

# --fail so an HTTP error is an exit code rather than an error page
# written out as a certificate. The engine's reply is RFC 9457 problem
# JSON, which is not a PEM file.
if ! curl --fail --silent --show-error \
          --header "Content-Type: application/json" \
          --data "@$request" \
          "$ENGINE/v1/certificates/bootstrap" > "$response"; then
    echo "aisvc-fetch-cert: the engine refused this token" >&2
    echo "  A token is single-use and expires in 30 minutes; redeploy" >&2
    echo "  the proxy to mint a new one." >&2
    exit 1
fi

python3 - "$response" "$OUT_DIR" <<'PY'
import json
import os
import sys

body = json.load(open(sys.argv[1]))
out = sys.argv[2]

# Both or neither: a half-written pair leaves nginx blaming the file
# rather than the fetch that produced it, and the token is already
# spent by then.
material = {
    "fullchain.pem": body.get("certificate"),
    "privkey.pem": body.get("privatekey"),
}
missing = [name for name, value in material.items() if not value]
if missing:
    sys.exit(f"aisvc-fetch-cert: the engine returned no {', '.join(missing)}")

for name, value in material.items():
    path = os.path.join(out, name)
    with open(path, "w") as handle:
        handle.write(value)
    os.chmod(path, 0o600)
PY

echo "aisvc-fetch-cert: wrote $OUT_DIR/fullchain.pem and $OUT_DIR/privkey.pem"
