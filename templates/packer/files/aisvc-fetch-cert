#!/usr/bin/env bash
# Fetch this proxy's TLS material from the engine (SPEC.md section 8).
#
# Called by cloud-init at first boot. The material is NOT in the
# userdata on purpose: that document is readable through the CloudStack
# API by anyone who can see the VM, so a private key there is a private
# key published. It is fetched here instead, over mTLS, by id.
#
# The engine is unreachable from tenant networks; this runs on the
# proxy, which sits on both.
set -euo pipefail

usage() {
    echo "usage: aisvc-fetch-cert --id <certificate-id> --out <dir>" >&2
    exit 2
}

CERT_ID=""
OUT_DIR="/etc/aisvc/tls"
ENGINE="${AISVC_ENGINE_URL:-}"
MTLS_DIR="${AISVC_MTLS_DIR:-/etc/aisvc/mtls}"

while [ $# -gt 0 ]; do
    case "$1" in
        --id) CERT_ID="${2:-}"; shift 2 ;;
        --out) OUT_DIR="${2:-}"; shift 2 ;;
        --engine) ENGINE="${2:-}"; shift 2 ;;
        *) usage ;;
    esac
done

[ -n "$CERT_ID" ] || usage
if [ -z "$ENGINE" ]; then
    echo "aisvc-fetch-cert: no engine URL; set AISVC_ENGINE_URL or pass --engine" >&2
    exit 1
fi

install -d -m 0700 "$OUT_DIR"
umask 077

# Written to a temporary file first: a half-written key would leave
# nginx serving a certificate it cannot use, and the failure would look
# like a bad upload rather than a bad fetch.
response="$(mktemp)"
trap 'rm -f "$response"' EXIT

curl --fail --silent --show-error \
     --cert "$MTLS_DIR/client.crt" \
     --key "$MTLS_DIR/client.key" \
     --cacert "$MTLS_DIR/ca.crt" \
     -H "X-Aisvc-User-Id: proxy" \
     -H "X-Aisvc-Account: system" \
     -H "X-Aisvc-Domain: /" \
     -H "X-Aisvc-Role: Admin" \
     "$ENGINE/v1/certificates/$CERT_ID/material" > "$response"

python3 - "$response" "$OUT_DIR" <<'PY'
import json
import os
import sys

body = json.load(open(sys.argv[1]))
out = sys.argv[2]

for field, name in (("certificate", "fullchain.pem"), ("privatekey", "privkey.pem")):
    material = body.get(field)
    if not material:
        # Better to fail than to write an empty file nginx will refuse
        # with an error that points at the file rather than the fetch.
        sys.exit(f"aisvc-fetch-cert: the engine returned no {field}")
    path = os.path.join(out, name)
    with open(path, "w") as handle:
        handle.write(material)
    os.chmod(path, 0o600)
PY

echo "aisvc-fetch-cert: wrote $OUT_DIR/fullchain.pem and $OUT_DIR/privkey.pem"
